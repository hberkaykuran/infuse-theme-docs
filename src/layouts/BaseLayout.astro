---
import '../styles/global.css';
import { withBase } from '../nav.js';
// Minimal document shell for the landing page. The landing supplies its own
// nav + footer (they are part of the approved mockup), so no site chrome here.
const { title, description = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={withBase('/favicon.svg')} />
  <link rel="preload" href={withBase('/fonts/fraunces-var.woff2')} as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
</body>
</html>
